# Copy this file to a private root-owned location outside the repository.
# Replace every value with deployment-specific values, then set mode 0600.
REPO_ROOT=/path/to/repository
DATA_ROOT=/path/to/private-data
QSHELL_BIN=/path/to/qshell
QINIU_BUCKET=replace-with-private-bucket-name
GPG_PASSPHRASE_FILE=/path/to/gpg-passphrase-file

# Include every container that writes into DATA_ROOT. This stop sequence should
# put the reverse proxy last, so it remains available while dependencies stop.
BACKUP_CONTAINERS="application worker database cache reverse-proxy"

# Restart dependencies before applications and keep the reverse proxy last.
# Every name in BACKUP_CONTAINERS must appear here.
BACKUP_START_CONTAINERS="database cache application worker reverse-proxy"
BACKUP_PREFIX=server
BACKUP_WORK_DIR="${DATA_ROOT}/backups/staging"
STOP_TIMEOUT_SECONDS=30
